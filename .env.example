# ========== 基础服务连接（docker-compose 默认值保持一致） ==========
POSTGRES_USER=kbrag
POSTGRES_PASSWORD=kbrag
POSTGRES_DB=kbrag
DATABASE_URL=postgresql+asyncpg://kbrag:kbrag@localhost:5432/kbrag

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kbrag
MINIO_SECRET_KEY=kbrag123456
MINIO_BUCKET=kbrag
# 设为 true 时启动自动创建 bucket（需要 minio 已就绪）
MINIO_SECURE=false

# ========== API 鉴权 ==========
# 查询/读取级 API Key（调用 kb_search、查询接口）
API_KEY_QUERY=dev-query-key-change-me
# 管理级 API Key（上传/删除/设置修改），必须不同于 QUERY key
API_KEY_ADMIN=dev-admin-key-change-me
# 加密 settings 表中的 API Key 用，生产环境必须替换为强随机值
APP_SECRET=dev-app-secret-change-me

# ========== 云模型 API（兜底默认值，网页设置页配置优先） ==========
# 阿里云百炼 DashScope（OpenAI 兼容协议）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank-v2
VLM_MODEL=qwen-vl-max

# ========== 检索与生成 ==========
RETRIEVE_VECTOR_TOP_K=30
RETRIEVE_BM25_TOP_K=30
RERANK_TOP_K=8
CONTEXT_TOKEN_BUDGET=5000
CHUNK_TOKEN_TARGET=400
CHUNK_TOKEN_MAX=500

# ========== 目录监视（Phase 2 启用） ==========
WATCH_DIR_IMPORTANT=./data/kb-drop/important
WATCH_DIR_NORMAL=./data/kb-drop/normal

# ========== 上传限制 ==========
UPLOAD_MAX_MB=500
